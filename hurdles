'use client';

import React, { useEffect, useRef } from 'react';

type SpriteSet = {
  player: HTMLImageElement;
  stone: HTMLImageElement;
  rivalRed: HTMLImageElement;
  rivalGreen: HTMLImageElement;
  grassTile: HTMLImageElement;
  roadTile: HTMLImageElement;
  curbTile: HTMLImageElement;
  dashTile: HTMLImageElement;
};

type Obstacle = {
  lane: number; // 0, 1, 2
  y: number;
  kind: 'stone' | 'rival-red' | 'rival-green';
};

const W = 360;
const H = 540;
const ROAD_X = 44;
const ROAD_W = 272;
const LANE_XS = [90, 180, 270];

function loadImage(src: string): Promise<HTMLImageElement> {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.src = src;
    img.onload = () => resolve(img);
    img.onerror = reject;
  });
}

function tileImage(
  ctx: CanvasRenderingContext2D,
  img: HTMLImageElement,
  x: number,
  y: number,
  w: number,
  h: number
) {
  const iw = img.width || 16;
  const ih = img.height || 16;

  for (let yy = y; yy < y + h; yy += ih) {
    for (let xx = x; xx < x + w; xx += iw) {
      ctx.drawImage(img, xx, yy, iw, ih);
    }
  }
}

function drawSprite(
  ctx: CanvasRenderingContext2D,
  img: HTMLImageElement,
  x: number,
  y: number,
  w: number,
  h: number
) {
  ctx.drawImage(img, x, y, w, h);
}

export default function RetroArcadeRacer() {
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  const spritesRef = useRef<Partial<SpriteSet>>({});
  const obstaclesRef = useRef<Obstacle[]>([
    { lane: 0, y: -80, kind: 'stone' },
    { lane: 2, y: -220, kind: 'rival-red' },
    { lane: 1, y: -360, kind: 'rival-green' },
  ]);
  const playerLaneRef = useRef(1);
  const playerY = 450;
  const speedRef = useRef(1.4);
  const lastTimeRef = useRef(0);
  const runningRef = useRef(true);

  useEffect(() => {
    let alive = true;

    async function init() {
      const [player, stone, rivalRed, rivalGreen, grassTile, roadTile, curbTile, dashTile] =
        await Promise.all([
          loadImage('/sprites/player-blue-f1.png'),
          loadImage('/sprites/stone-block.png'),
          loadImage('/sprites/rival-red.png'),
          loadImage('/sprites/rival-green.png'),
          loadImage('/sprites/grass-tile.png'),
          loadImage('/sprites/road-asphalt.png'),
          loadImage('/sprites/curb-redwhite.png'),
          loadImage('/sprites/lane-dash.png'),
        ]);

      if (!alive) return;

      spritesRef.current = {
        player,
        stone,
        rivalRed,
        rivalGreen,
        grassTile,
        roadTile,
        curbTile,
        dashTile,
      };

      const canvas = canvasRef.current;
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      ctx.imageSmoothingEnabled = false;

      const loop = (ts: number) => {
        if (!runningRef.current) return;
        if (!lastTimeRef.current) lastTimeRef.current = ts;

        const dt = Math.min(0.033, (ts - lastTimeRef.current) / 1000);
        lastTimeRef.current = ts;

        const s = spritesRef.current;
        if (!s.player || !s.stone || !s.rivalRed || !s.rivalGreen || !s.grassTile || !s.roadTile || !s.curbTile || !s.dashTile) {
          requestAnimationFrame(loop);
          return;
        }

        // Fixed camera background: no scrolling screen.
        ctx.clearRect(0, 0, W, H);

        // Grass sides
        tileImage(ctx, s.grassTile, 0, 0, ROAD_X, H);
        tileImage(ctx, s.grassTile, ROAD_X + ROAD_W, 0, W - (ROAD_X + ROAD_W), H);

        // Road asphalt
        tileImage(ctx, s.roadTile, ROAD_X, 0, ROAD_W, H);

        // Chunky curb blocks
        tileImage(ctx, s.curbTile, ROAD_X - 10, 0, 10, H);
        tileImage(ctx, s.curbTile, ROAD_X + ROAD_W, 0, 10, H);

        // Lane dashes
        tileImage(ctx, s.dashTile, ROAD_X + 66, 0, 8, H);
        tileImage(ctx, s.dashTile, ROAD_X + 138, 0, 8, H);
        tileImage(ctx, s.dashTile, ROAD_X + 210, 0, 8, H);

        // Obstacles move downward only.
        const fallSpeed = 170 * speedRef.current;
        obstaclesRef.current = obstaclesRef.current.map((o) => ({
          ...o,
          y: o.y + fallSpeed * dt,
        }));

        // Respawn / recycle
        obstaclesRef.current = obstaclesRef.current.filter((o) => o.y < H + 40);
        if (obstaclesRef.current.length < 5) {
          const lane = Math.floor(Math.random() * 3);
          const kinds: Obstacle['kind'][] = ['stone', 'rival-red', 'rival-green'];
          obstaclesRef.current.push({
            lane,
            y: -60,
            kind: kinds[Math.floor(Math.random() * kinds.length)],
          });
        }

        // Draw obstacles with image sprites
        for (const o of obstaclesRef.current) {
          const x = LANE_XS[o.lane];
          const img =
            o.kind === 'stone'
              ? s.stone
              : o.kind === 'rival-red'
                ? s.rivalRed
                : s.rivalGreen;

          drawSprite(ctx, img, x - 16, o.y - 16, 32, 32);
        }

        // Player stays fixed at bottom, facing up.
        const playerLaneX = LANE_XS[playerLaneRef.current];
        drawSprite(ctx, s.player, playerLaneX - 18, playerY - 22, 36, 44);

        // Example scanline overlay can stay in CSS.
        requestAnimationFrame(loop);
      };

      requestAnimationFrame(loop);
    }

    init();

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') playerLaneRef.current = Math.max(0, playerLaneRef.current - 1);
      if (e.key === 'ArrowRight') playerLaneRef.current = Math.min(2, playerLaneRef.current + 1);
      if (e.key === 'ArrowUp') speedRef.current = 1.8;
      if (e.key === 'ArrowDown') speedRef.current = 1.1;
    };

    const onKeyUp = (e: KeyboardEvent) => {
      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') speedRef.current = 1.4;
    };

    window.addEventListener('keydown', onKeyDown);
    window.addEventListener('keyup', onKeyUp);

    return () => {
      alive = false;
      runningRef.current = false;
      window.removeEventListener('keydown', onKeyDown);
      window.removeEventListener('keyup', onKeyUp);
    };
  }, []);

  return (
    <div className="pixel-ui">
      <canvas
        ref={canvasRef}
        width={W}
        height={H}
        className="retroCanvas"
      />
    </div>
  );
}
